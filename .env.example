# Optional Express server (npm run dev:api). Not used by the GitHub Pages build.
PORT=8787
CORS_ORIGINS=http://localhost:5173,https://<your-user>.github.io
DEMO_MODE=false
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
TOMTOM_API_KEY=
BESTTIME_API_KEY_PRIVATE=
# slug:venue_id pairs; slugs are in server/src/data/venues.json
BESTTIME_VENUE_IDS=
ADMIN_TOKEN=
ENABLE_DEMO_ENDPOINTS=true
POLL_INTERVAL_MS=30000
RATE_LIMIT_PER_MIN=120
