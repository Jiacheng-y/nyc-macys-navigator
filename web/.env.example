# Copy to web/.env.local. ALL of these end up in the public JavaScript bundle.
# Google Maps Platform key with Maps JavaScript API + Routes API + Geocoding API enabled.
# Restrict it by HTTP referrer (http://localhost:5173/*, https://<user>.github.io/*) and cap quota.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional: TomTom Traffic Flow key (public in the bundle — use a restricted, free-tier key).
VITE_TOMTOM_API_KEY=
# Optional: URL of the Express server (npm run dev:api). Needed for BestTime, whose private key must never be in a browser.
VITE_API_BASE=
# Force simulated data everywhere.
VITE_DEMO_MODE=false
VITE_POLL_INTERVAL_MS=30000
