{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "google.maps", "node"],
    "baseUrl": ".",
    "paths": { "@engine/*": ["../server/src/*"], "@shared/*": ["../shared/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
